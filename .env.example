# Valeurs fictives pour documenter la configuration locale.
# Copier ce fichier en .env pour votre usage, sans jamais le versionner.
# Reporter les valeurs dans wp-config.php, ou les lire avec getenv() si vous utilisez Docker.

WP_ENV=local

DB_NAME=mqb_local
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost

WP_HOME=http://mqb.local
WP_SITEURL=http://mqb.local

WP_DEBUG=true
